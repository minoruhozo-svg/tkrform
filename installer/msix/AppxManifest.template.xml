<?xml version="1.0" encoding="utf-8"?>
<!--
  TKRForm の MSIX（Microsoft Store 版）のマニフェストのひな形。build-msix.ps1 が、{{...}} を埋めて AppxManifest.xml を作る。

  Identity の Name / Publisher、表示名は、Partner Center で予約した値に差し替える（build-msix.ps1 の引数）。

  仮想化を止める宣言（制限付きの unvirtualizedResources など）は使わない。仕様書.md の「Microsoft Store 版（MSIX）」の節を参照。
  要点: Chrome / Edge は、レジストリの HKCU\Software\{Google\Chrome,Microsoft\Edge}\NativeMessagingHosts\jp.tkrs.tkrform と、
  %LOCALAPPDATA%\tkrform\nm の中のマニフェストと NM ホストを、パッケージの外から読む。アプリ自身が書くと仮想化されて見えないため、
  アプリは、パッケージの外で動かした cmd.exe / reg.exe（System32）に、データのフォルダの作成と HKCU の登録をさせる（src/msix.rs）。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 対象は Windows 11 以降（動作を確かめているのは Windows 11 だけのため） -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="TKRForm" Executable="TKRForm.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="Password manager and form filler for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- 自動起動。設定の「Windows の起動時に起動する」と連動する（StartupTask API）。既定はオフ。
             uap10:Parameters で起動の引数（ハイフン 2 つと background）を渡し、起動しても画面を出さずに、ロックしたままトレイで待つ。 -->
        <desktop:Extension Category="windows.startupTask" Executable="TKRForm.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--background">
          <desktop:StartupTask TaskId="TKRFormStartup" Enabled="false" DisplayName="{{DISPLAY_NAME}}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
