<?xml version="1.0" encoding="utf-8"?>
<!--
  TKRForm の MSIX（Microsoft Store 版）のマニフェストのひな形。build-msix.ps1 が、{{...}} を埋めて AppxManifest.xml を作る。

  Identity の Name / Publisher、表示名は、Partner Center で予約した値に差し替える（build-msix.ps1 の引数）。

  仮想化の宣言（Properties と Capabilities の unvirtualizedResources）の理由は、仕様書.md の「Microsoft Store 版（MSIX）」の節。
  要点: Chrome / Edge は、レジストリの HKCU\Software\{Google\Chrome,Microsoft\Edge}\NativeMessagingHosts\jp.tkrs.tkrform と、
  %LOCALAPPDATA%\tkrform\nm の中のマニフェストと NM ホストを、パッケージの外から読む。仮想化されると、パッケージの中にしか見えず、拡張が接続できない。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap desktop desktop6 rescap virtualization">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>

    <!-- ファイルは、仮想化を止める場所を必要なものだけに限る（Windows 11 以降の指定。AppData 全体を止める広い指定は使わない）。 -->
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <!-- 保管庫・設定・NM ホストのコピー・拡張のコピー（インストーラ版と同じ保管庫を使うため、仮想化しない） -->
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\tkrform</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
    <!-- レジストリは、virtualization:ExcludedKeys が Windows 11 の実機（Build 26300）で効かなかったため、HKCU 全体の仮想化を止める旧式の指定にする。
         Chrome / Edge が読む NM ホストの登録（HKCU\Software\{Google\Chrome,Microsoft\Edge}\NativeMessagingHosts\jp.tkrs.tkrform）を、パッケージの外に見せるため。 -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <!-- virtualization: の除外の指定が使えるのは Windows 11（10.0.22000）以降。このため、対象を Windows 11 以降にする -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="TKRForm" Executable="TKRForm.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="Password manager and form filler for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
    <!-- 裏で起動するための、一覧に出ない入口（同じ実行ファイル）。ブラウザの拡張・接続役からの起動と、Windows ログオン時の自動起動は、
         この入口を使う。アプリは、自分のアプリ ID がこれであることで、「裏で起動された」と確実に分かる（起動時の引数や、
         StartupTask の判定に頼らない）。裏で起動されたら、画面も Windows Hello も出さず、ロックしたままトレイで待つ。 -->
    <Application Id="TKRFormBackground" Executable="TKRForm.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="{{DISPLAY_NAME}}"
        Description="Password manager and form filler for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- 自動起動。設定の「Windows の起動時に起動する」と連動する（StartupTask API）。既定はオフ -->
        <desktop:Extension Category="windows.startupTask" Executable="TKRForm.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TKRFormStartup" Enabled="false" DisplayName="{{DISPLAY_NAME}}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
