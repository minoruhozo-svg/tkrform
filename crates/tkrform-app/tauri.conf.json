{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TKRForm",
  "version": "0.2.0",
  "identifier": "jp.tkrs.tkrform",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Takara Syscom",
    "copyright": "Copyright (c) 2026 Takara Syscom",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
